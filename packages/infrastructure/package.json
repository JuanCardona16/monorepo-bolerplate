{
  "name": "@repo/infrastructure",
  "version": "1.0.0",
  "description": "Infrastructure layer for the authentication service",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./persistence/postgresSql": {
      "types": "./dist/persistence/postgresSql/index.d.ts",
      "default": "./dist/persistence/postgresSql/index.js"
    }
  },
  "scripts": {
    "build:js": "tsup",
    "build:types": "tsc",
    "build": "pnpm build:js && pnpm build:types",
    "dev": "tsup --watch --onSuccess \"pnpm run build:types\"",
    "test": "vitest run --passWithNoTests",
    "prisma:generate": "prisma generate --schema ./src/persistence/postgresSql/prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema ./src/persistence/postgresSql/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema ./src/persistence/postgresSql/prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema ./src/persistence/postgresSql/prisma/schema.prisma",
    "postinstall": "pnpm run prisma:generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@prisma/config": "7.10.0",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@repo/core": "workspace:*",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  }
}