{
  "name": "@repo/infrastructure",
  "version": "1.0.0",
  "description": "Infrastructure layer for the authentication service",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./persistence/mongo": {
      "types": "./dist/persistence/mongo/index.d.ts",
      "default": "./dist/persistence/mongo/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "default": "./dist/email/index.js"
    }
  },
  "scripts": {
    "build:js": "tsup",
    "build:types": "tsc",
    "build": "pnpm build:js && pnpm build:types",
    "check-types": "tsc --noEmit -p tsconfig.test.json",
    "dev": "tsup --watch --onSuccess \"pnpm run build:types\"",
    "test": "vitest run",
    "mongo:promote-admin": "tsx src/persistence/mongo/scripts/promoteAdmin.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "dotenv": "^17.4.2",
    "mongoose": "^8.24.4"
  }
}