{
  // Type-checks the test suite without emitting anything.
  //
  // `tsconfig.json` excludes `src/**/__tests__/**` so the compiled tests never
  // reach `dist/`. The side effect is that `build:types` never type-checks the
  // tests at all: a broken test file only fails at Vitest transform time, if at
  // all. This config closes that hole.
  //
  // `noEmit` keeps the check side-effect free, so it never produces a `tsconfig.tsbuildinfo`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
