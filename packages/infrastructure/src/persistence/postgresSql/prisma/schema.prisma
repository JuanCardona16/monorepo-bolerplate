generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model AuthUserSchema {
  uuid         String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  roles        String[] @default([])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("auth_users")
}

model RefreshTokenSchema {
  id        String    @id @default(uuid())
  userUuid  String    @map("user_uuid")
  tokenHash String    @unique @map("token_hash")
  roles     String[]  @default([])
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  // Explicit 30-day opt-in. Defaults true so pre-existing rows keep the
  // lifetime they were issued with; new short sessions store false.
  rememberMe Boolean  @default(true) @map("remember_me")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userUuid])
  @@map("refresh_tokens")
}

// Password reset tokens are kept in their own table, not folded into
// `refresh_tokens`. The lifecycles are unrelated: these expire in an hour and
// burn on first use, refresh tokens last 30 days and rotate. Sharing a table
// would make "revoke every session" ambiguous between the two meanings of
// "revoke", which is exactly the kind of coupling that produces a bug where a
// password reset kills a user's sessions, or the other way round.
//
// `token_hash` is unique and holds a sha256 digest, never the token itself: a
// leak of this table must not let anyone reset an account.
//
// There is deliberately no foreign key to `auth_users`, matching
// `refresh_tokens`. A dangling token is rejected by the use case, and an
// explicit rule here would only add a second place to keep in sync.
model PasswordResetTokenSchema {
  id        String    @id @default(uuid())
  userUuid  String    @map("user_uuid")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userUuid])
  @@map("password_reset_tokens")
}

