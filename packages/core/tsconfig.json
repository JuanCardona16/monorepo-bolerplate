{
  // Visit https://aka.ms/tsconfig to read more about this file
  "extends": "../typescript-config/base.json",
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist"
  },
  // There is no `include`, so tsc globs every .ts under the package. Without
  // the `__tests__` exclusion it emits compiled tests plus their .d.ts files
  // into dist/, which then ships as part of the published surface.
  "exclude": [
    "node_modules",
    "dist",
    "tsup.config.ts",
    "vitest.config.ts",
    "src/**/__tests__/**"
  ]
}
