{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      // `dist/**` covers every workspace package that emits files: the three
      // libraries (tsup) and apps/web (Vite). apps/api-gateway emits nothing.
      // `.next/**` was a Turborepo starter leftover: there is no Next.js app in
      // this repo (apps/web is Vite), so it widened every cache key with globs
      // that match nothing.
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      // Set completo que leen `apps/api-gateway` y los tests de
      // `infrastructure`: sin declararlo, `turbo/no-undeclared-env-vars`
      // warnnea y el cache ignora cambios en estas variables.
      "env": [
        "ACCESS_LOG_IPS",
        "ACCESS_TOKEN_TTL",
        "CI",
        "DOCS_ENABLED",
        "EMAIL_FROM",
        "NODE_ENV",
        "OPENAPI_SERVER_URL",
        "PASSWORD_RESET_URL",
        "PORT",
        "REFRESH_COOKIE_SAME_SITE",
        "REFRESH_COOKIE_SECURE",
        "REFRESH_TOKEN_SECRET_KEY",
        "RESEND_API_KEY",
        "TOKEN_SECRET_KEY"
      ]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      // Caching off for this task, and only this one.
      //
      // `test` now depends on a live database, and no cache key can see what is
      // inside it: the applied migrations, rows a previous run left behind, a
      // server that came up with a different schema. A replayed "98 passed" is a
      // claim about a database that no longer exists — the same false green as
      // skipping the suites, just harder to spot because nothing looks wrong.
      //
      // Scoped here rather than via TURBO_FORCE in the workflow, which would also
      // disable the cache for `build` and throw away the expensive part. The
      // suites take seconds; a full tsup + tsc build does not.
      "cache": false,
      // `.env*` in the inputs, kept for the non-database suites: without it a
      // change to `.env.local` would not invalidate anything.
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      // Declared so Turbo both hashes it into the cache key and passes it
      // through to the task. Undeclared, `turbo run test` filtered it out and
      // the integration tests that need a real database skipped themselves
      // with `describe.skip` — on every run, not only in CI. They were
      // unreachable through the normal command.
      "env": ["MONGODB_URI"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
