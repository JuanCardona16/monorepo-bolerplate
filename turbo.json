{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      // `.env*` in the inputs: without it, a cached test result is reused after
      // `.env.local` changes, so `pnpm test` can return a green built against an
      // environment that no longer exists. `build` already declared it.
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      // Declared so Turbo both hashes it into the cache key and passes it
      // through to the task. Undeclared, `turbo run test` filtered it out and
      // the 35 integration tests that need a real database skipped themselves
      // with `describe.skipIf(!process.env.DATABASE_URL)` — on every run, not
      // only in CI. They were unreachable through the normal command.
      "env": ["DATABASE_URL"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
